# MessMate Backend Environment Configuration
# Copy this file to backend/.env for local overrides.

PROJECT_NAME="MessMate Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite default; can be switched to PostgreSQL in production)
DATABASE_URL="sqlite:///./data/messmate.db"

# JWT Authentication Security
SECRET_KEY="messmate-development-insecure-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (Allows local frontend dev server)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Institution Default Parameters
INSTITUTION_NAME="IIIT Dharwad"
TIMEZONE="Asia/Kolkata"
DEFAULT_BASELINE_ATTENDANCE=700
DEFAULT_SAFETY_MARGIN=0.08
TOTAL_REGISTERED_STUDENTS=750
