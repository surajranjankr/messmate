# MessMate Backend Environment Configuration
# Copy this file to backend/.env for local overrides. Never commit .env to Git.

PROJECT_NAME="MessMate Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Backend Selection: "sqlite" | "mongodb"
DATABASE_BACKEND="sqlite"

# SQLite Configuration (Default local fallback)
DATABASE_URL="sqlite:///./data/messmate.db"

# MongoDB Atlas Configuration
# Example: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DATABASE="messmate"

# External API: Resend Email Integration (Prepared for future activation)
# Get your API key from https://resend.com/api-keys
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# External API: WhatsApp Integration (Deferred)
WHATSAPP_PROVIDER="mock"

# JWT Authentication Security (MUST change in production: min 32 characters)
SECRET_KEY="messmate-development-insecure-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (Allows local frontend dev server & production domains)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Institution Default Parameters
INSTITUTION_NAME="IIIT Dharwad"
TIMEZONE="Asia/Kolkata"
DEFAULT_BASELINE_ATTENDANCE=700
DEFAULT_SAFETY_MARGIN=0.08
TOTAL_REGISTERED_STUDENTS=750
