# MessMate Frontend Production Environment Configuration
# Copy this file to frontend/.env.local for local overrides. Never store secrets here.

VITE_APP_NAME="MessMate"
VITE_INSTITUTION="IIIT Dharwad"

# Backend API endpoint (Set to your deployed FastAPI HTTPS URL in production)
# Example for local development: http://localhost:8000/api/v1
# Example for production: https://messmate-api.onrender.com/api/v1
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Local browser storage key prefix
VITE_STORAGE_PREFIX="MESSMATE_STORAGE_V1"
